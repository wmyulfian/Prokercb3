rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && myProfile().role == 'admin';
    }

    function isPengurus() {
      return signedIn() && myProfile().role == 'pengurus';
    }

    function myPengurusId() {
      return myProfile().pengurusId;
    }

    match /users/{uid} {
      // Profil hanya dapat dibaca oleh pemilik akun.
      // Buat/perbarui profil awal melalui Firebase Console atau Admin SDK.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /pengurus/{pengurusId} {
      allow get: if isAdmin() || (isPengurus() && myPengurusId() == pengurusId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /program_kerja/{programId} {
      // Query pengurus harus dibatasi dengan penanggungJawabId == users/{uid}.pengurusId.
      allow get, list: if isAdmin() ||
        (isPengurus() && resource.data.penanggungJawabId == myPengurusId());
      allow create, update, delete: if isAdmin();
    }

    match /usulan_program/{usulanId} {
      // Pengurus hanya dapat membaca usulannya sendiri.
      allow get, list: if isAdmin() ||
        (isPengurus() && resource.data.pengurusId == myPengurusId());

      allow create: if isAdmin() || (
        isPengurus() &&
        request.resource.data.pengurusId == myPengurusId() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == 'pending'
      );

      // Keputusan persetujuan, revisi, atau penolakan hanya oleh admin.
      allow update, delete: if isAdmin();
    }
  }
}
