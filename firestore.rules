rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Profil Firebase Auth hanya boleh dibaca pemiliknya.
    // Pembuatan/perubahan profil Admin dilakukan secara manual atau melalui server tepercaya.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Semua akses dari browser untuk data organisasi hanya milik Admin.
    // Pengurus memakai Vercel API yang memvalidasi sesi internal, lalu mengakses
    // Firestore melalui Firebase Admin SDK di server.
    match /pengurus/{pengurusId} {
      allow read, write: if isAdmin();
    }

    match /program_kerja/{programId} {
      allow read, write: if isAdmin();
    }

    match /usulan_program/{usulanId} {
      allow read, write: if isAdmin();
    }

    // Hash password, salt, sesi, dan pembatasan percobaan login tidak boleh
    // pernah dibaca atau ditulis langsung dari browser.
    match /akun_pengurus/{loginName} {
      allow read, write: if false;
    }

    match /_pengurus_login_limits/{limitId} {
      allow read, write: if false;
    }

    // Tolak secara default seluruh koleksi yang belum diatur secara eksplisit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
